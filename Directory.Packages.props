<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- EF Core -->
    <PackageVersion Include="Ardalis.SmartEnum" Version="8.1.0" />
    <PackageVersion Include="Ardalis.SmartEnum.SystemTextJson" Version="8.1.0" />
    <PackageVersion Include="Ardalis.SmartEnum.EFCore" Version="8.1.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.SqlServer" Version="9.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.11" />
    <!-- ASP.NET Core -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.11" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.15.0-beta.1" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.0.36" />
    <!-- MediatR (CQRS) -->
    <PackageVersion Include="MediatR" Version="12.4.1" />
    <!-- Messaging -->
    <PackageVersion Include="MassTransit" Version="8.3.6" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.3.6" />
    <!-- Azure Service Bus transport: latest published 8.3.x; floors at MassTransit >= 8.3.5 so it resolves cleanly against the 8.3.6 core above. -->
    <PackageVersion Include="MassTransit.Azure.ServiceBus.Core" Version="8.3.5" />
    <!-- Azure SDK for the Service Bus emulator's two-plane wiring (see ADR-0001).
         MassTransit.Azure.ServiceBus.Core 8.3.5 pulls this transitively at 7.18.2,
         but 7.18.2 has a bug where ServiceBusAdministrationClient RESETS the custom
         emulator port (e.g. :5300) — fixed in 7.20.1 (2025-06-12). The emulator's
         management plane lives on a separate HTTP port (5300) from the AMQP data
         plane (5672); MassTransit's startup topology creation goes through the
         administration client, so without this floor it lands on https://localhost:443
         and faults forever. We add an explicit PackageReference in the MassTransit
         project so this Central-Package-Management version actually applies (a
         PackageVersion entry alone does NOT pin a transitive dependency). -->
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
    <PackageVersion Include="MassTransit.EntityFrameworkCore" Version="8.3.6" />
    <PackageVersion Include="WolverineFx" Version="6.4.3" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="6.4.3" />
    <!-- Wolverine Azure Service Bus transport: pinned to the same WolverineFx
         version (6.4.3) as the core/RabbitMQ packages so the transport resolves
         cleanly against the shared Wolverine core. The 6.x line exposes
         AzureServiceBusTransport.ManagementConnectionString, which lets the
         emulator's port-5300 management plane be wired explicitly (see ADR-0003). -->
    <PackageVersion Include="WolverineFx.AzureServiceBus" Version="6.4.3" />
    <PackageVersion Include="WolverineFx.SqlServer" Version="6.4.3" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.4.3" />
    <!-- WolverineFx 6 split the Roslyn runtime compiler out of the core package
         (GH-2876). Without it, the default TypeLoadMode.Dynamic throws at host start
         ("no IAssemblyGenerator registered"). Referencing this package auto-registers
         the generator, restoring the 4.x runtime-compilation behaviour with no code
         change — and it is broker-agnostic (the crash hit RabbitMQ and ASB alike). -->
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.4.3" />
    <!-- Configuration -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <!-- Logging -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <!-- Validation -->
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageVersion Include="MSTest.TestFramework" Version="3.6.4" />
    <PackageVersion Include="FluentAssertions" Version="8.0.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Shouldly" Version="4.2.1" />
    <PackageVersion Include="NBuilder" Version="6.1.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.11" />
    <!-- Aspire ServiceDefaults -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.1.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.14.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.14.0" />
    <!-- Aspire Hosting -->
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.1.1" />
    <PackageVersion Include="Aspire.Hosting.Azure.ServiceBus" Version="13.1.1" />
	<PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.1.1" />
	<!-- Authentication && Authorization -->
	<PackageVersion Include="Duende.IdentityServer" Version="7.4.7" />
	<PackageVersion Include="Duende.IdentityServer.AspNetIdentity" Version="7.4.7" />
	<PackageVersion Include="Duende.IdentityServer.EntityFramework" Version="7.4.7" />
	<PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.3" />
	<PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="9.0.3" />
	<PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.3" />
	<PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="9.0.3" />
</ItemGroup>
</Project>