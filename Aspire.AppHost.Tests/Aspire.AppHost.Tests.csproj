<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Aspire.AppHost.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile WorktreeSlot.cs directly from the AppHost project so tests cover
         the exact same class without pulling in the Aspire.AppHost.Sdk. -->
    <Compile Include="..\Aspire.AppHost\WorktreeSlot.cs" Link="WorktreeSlot.cs" />
  </ItemGroup>

</Project>
