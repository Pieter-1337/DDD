<Project Sdk="Aspire.AppHost.Sdk/13.1.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>12d3119a-ea1f-43ad-b1f3-6c5072eb7dcd</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referenced for BrokerNames so the orchestrator's broker switch uses the
         same canonical constants as the services and extensions (ADR-0001, no drift).
         IsAspireProjectResource=false: this is a normal compile reference, not an
         Aspire resource to provision (without it the AppHost SDK treats project
         references as resources only and does not flow them to the compiler). -->
    <ProjectReference Include="..\BuildingBlocks\BuildingBlocks.Application\BuildingBlocks.Application.csproj"
                      IsAspireProjectResource="false" />
    <!-- Shared worktree-slot mechanics (formula, ports, connection-string rewrite).
         IsAspireProjectResource=false for the same reason as above. -->
    <ProjectReference Include="..\BuildingBlocks\BuildingBlocks.WorktreeSlots\BuildingBlocks.WorktreeSlots.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\WebApplications\Identity.WebApi\Identity.WebApi.csproj" />
    <ProjectReference Include="..\WebApplications\Scheduling.WebApi\Scheduling.WebApi.csproj" />
    <ProjectReference Include="..\WebApplications\Billing.WebApi\Billing.WebApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" />
	<PackageReference Include="Aspire.Hosting.JavaScript" />
  </ItemGroup>

</Project>
